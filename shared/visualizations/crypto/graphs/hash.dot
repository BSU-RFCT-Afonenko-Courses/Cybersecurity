digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "n0" [id="n0", label="Данные произвольной длины"];
 "n1" [id="n1", label="Криптографическая хеш-функция"];
 "n2" [id="n2", label="Дайджест фиксированной длины\nне ключ для расшифрования"];
 "n0" -> "n1" [label=""];
 "n1" -> "n2" [label=""];
}
