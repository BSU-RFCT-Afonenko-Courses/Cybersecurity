digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "n0" [id="n0", label="Открытый текст"];
 "n1" [id="n1", label="Шифрование\nсекретный ключ K"];
 "n2" [id="n2", label="Шифротекст"];
 "n3" [id="n3", label="Расшифрование\nтот же ключ K"];
 "n4" [id="n4", label="Исходный текст"];
 "n0" -> "n1" [label=""];
 "n1" -> "n2" [label=""];
 "n2" -> "n3" [label=""];
 "n3" -> "n4" [label=""];
}
