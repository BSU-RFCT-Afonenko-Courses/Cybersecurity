digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "n0" [id="n0", label="Текст ABC, сдвиг 3\nбайты 65, 66, ключ 42"];
 "n1" [id="n1", label="Цезарь: DEF\nXOR: 107, 104"];
 "n2" [id="n2", label="Обратно: сдвиг −3\nповторный XOR с 42"];
 "n3" [id="n3", label="ABC\n65, 66"];
 "n0" -> "n1" [label=""];
 "n1" -> "n2" [label=""];
 "n2" -> "n3" [label=""];
}
