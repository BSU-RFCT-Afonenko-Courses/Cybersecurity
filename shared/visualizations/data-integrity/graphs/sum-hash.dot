digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "n0" [id="n0", label="Байты 10, 20"];
 "n1" [id="n1", label="Сумма mod 256 = 30\nпростая арифметика"];
 "n2" [id="n2", label="SHA-256\n256-битный дайджест"];
 "n3" [id="n3", label="Совпадение суммы не доказывает равенство\nхеш также требует доверенного эталона"];
 "n0" -> "n1" [label=""];
 "n0" -> "n2" [label=""];
 "n1" -> "n3" [label=""];
 "n2" -> "n3" [label=""];
}
