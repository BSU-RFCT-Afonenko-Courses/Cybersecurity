digraph G {
graph [bgcolor="transparent", pad="0.12"];
node [shape=plain, fontname="DejaVu Sans", fontsize=22];
raid [label=<
<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="18"><TR>
<TD VALIGN="TOP"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="5" CELLPADDING="12" COLOR="#a7b8cc">
<TR><TD COLSPAN="3" BORDER="0"><B>RAID 0</B></TD></TR>
<TR><TD BGCOLOR="#edf2f8">Диск 1</TD><TD BGCOLOR="#edf2f8">Диск 2</TD><TD BGCOLOR="#edf2f8">Диск 3</TD></TR>
<TR><TD BGCOLOR="#dceef9">A</TD><TD BGCOLOR="#dceef9">B</TD><TD BGCOLOR="#dceef9">C</TD></TR>
<TR><TD BGCOLOR="#dceef9">D</TD><TD BGCOLOR="#dceef9">E</TD><TD BGCOLOR="#dceef9">F</TD></TR>
<TR><TD BGCOLOR="#dceef9">G</TD><TD BGCOLOR="#dceef9">H</TD><TD BGCOLOR="#dceef9">I</TD></TR>
<TR><TD COLSPAN="3" BORDER="0">Соседние блоки<BR/>на разных дисках</TD></TR>
</TABLE></TD>
<TD VALIGN="TOP"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="5" CELLPADDING="12" COLOR="#a7b8cc">
<TR><TD COLSPAN="2" BORDER="0"><B>RAID 1</B></TD></TR>
<TR><TD BGCOLOR="#edf2f8">Диск 1</TD><TD BGCOLOR="#edf2f8">Диск 2</TD></TR>
<TR><TD BGCOLOR="#dceef9">A</TD><TD BGCOLOR="#dceef9">A</TD></TR>
<TR><TD BGCOLOR="#dceef9">B</TD><TD BGCOLOR="#dceef9">B</TD></TR>
<TR><TD BGCOLOR="#dceef9">C</TD><TD BGCOLOR="#dceef9">C</TD></TR>
