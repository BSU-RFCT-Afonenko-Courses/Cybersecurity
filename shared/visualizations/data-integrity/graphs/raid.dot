<TR><TD BGCOLOR="#edf2f8">Диск 1</TD><TD BGCOLOR="#edf2f8">Диск 2</TD><TD BGCOLOR="#edf2f8">Диск 3</TD></TR>
<TR><TD BGCOLOR="#dceef9">A</TD><TD BGCOLOR="#dceef9">B</TD><TD BGCOLOR="#fff0ca">P₁</TD></TR>
<TR><TD BGCOLOR="#dceef9">C</TD><TD BGCOLOR="#fff0ca">P₂</TD><TD BGCOLOR="#dceef9">D</TD></TR>
<TR><TD BGCOLOR="#fff0ca">P₃</TD><TD BGCOLOR="#dceef9">E</TD><TD BGCOLOR="#dceef9">F</TD></TR>
<TR><TD COLSPAN="3" BORDER="0">P₁ = A ⊕ B<BR/>P₂ = C ⊕ D<BR/>P₃ = E ⊕ F</TD></TR>
</TABLE></TD>
</TR></TABLE>
>];
