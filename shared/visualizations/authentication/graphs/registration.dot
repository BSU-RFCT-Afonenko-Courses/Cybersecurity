digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "n0" [id="n0", label="RP: доверенная привязка к аккаунту\nсвежий challenge и RP ID"];
 "n1" [id="n1", label="Браузер: navigator.credentials.create()\nпроверка origin и RP ID"];
 "n2" [id="n2", label="Аутентификатор: создаёт credential\nзакрытый ключ не передаётся RP"];
 "n3" [id="n3", label="RP: проверяет ответ\nсохраняет credential ID и открытый ключ"];
 "n0" -> "n1" [label=""];
 "n1" -> "n2" [label=""];
 "n2" -> "n3" [label=""];
}
