digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "subject" [id="subject", label="Процесс Анны"];
 "context" [id="context", label="Контекст: курс А или Б"];
 "teacher" [id="teacher", label="Преподаватель в А"];
 "student" [id="student", label="Студент в Б"];
 "permission" [id="permission", label="Преподаватель: просмотр, проверка\nСтудент: просмотр"];
 "monitor" [id="monitor", label="Монитор доступа"];
 "object" [id="object", label="Работа в выбранном курсе"];
 "subject" -> "context" [id="request-flow", label="запрос"];
 "context" -> "teacher" [label="назначение в А"];
 "context" -> "student" [label="назначение в Б"];
 "teacher" -> "permission" [label="права роли"];
 "student" -> "permission" [label="права роли"];
 "permission" -> "monitor" [id="policy-flow", label="проверка"];
 "monitor" -> "object" [id="access-flow", label="доступ"];
}
