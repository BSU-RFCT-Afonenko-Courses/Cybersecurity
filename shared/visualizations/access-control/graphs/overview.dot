digraph G {
 graph [rankdir=LR, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=12];
 edge [fontname="DejaVu Sans", fontsize=10];
 "subject" [id="subject", label="Субъект\nпроцесс с контекстом"];
 "monitor" [id="monitor", label="Монитор доступа"];
 "object" [id="object", label="Объект\nфайл или запись"];
 "policy" [id="policy", label="Политика\nкто, что и при каких условиях"];
 "subject" -> "monitor" [label="запрос операции"];
 "policy" -> "monitor" [label="правила"];
 "monitor" -> "object" [label="разрешить / отказать"];
}
