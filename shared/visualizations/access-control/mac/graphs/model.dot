digraph mac {
  graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.32", ranksep="0.55", splines=polyline];
  node [shape=box, style=rounded, fontname="DejaVu Sans", fontsize=12, color="#64748b"];
  edge [fontname="DejaVu Sans", fontsize=10, color="#94a3b8", arrowsize=0.6];
  l3 [id="level-3", label="L3 · закрытый"];
  l2 [id="level-2", label="L2 · служебный"];
  l1 [id="level-1", label="L1 · открытый"];
  f3 [id="file-3", label="Файл L3"];
  f2 [id="file-2", label="Файл L2"];
  f1 [id="file-1", label="Файл L1"];
  p [id="process", label="Процесс Лены · L2", shape=ellipse];
  {rank=same; l3; f3;}
  {rank=same; l2; p; f2;}
  {rank=same; l1; f1;}
  l3 -> l2 -> l1 [style=invis];
  f3 -> f2 -> f1 [style=invis];
  l2 -> p [style=invis];
  f1:w -> p:s [id="read-1", label="читать", constraint=false];
  f2:w -> p:e [id="read-2", label="читать", constraint=false];
  f3:w -> p:n [id="read-3", label="читать", constraint=false];
  p:sw -> f1:nw [id="write-1", label="добавить", style=dashed, constraint=false];
  p:se -> f2:s [id="write-2", label="добавить", style=dashed, constraint=false];
  p:nw -> f3:sw [id="write-3", label="добавить", style=dashed, constraint=false];
}
