digraph G {
 graph [rankdir=TB, ranksep=0.35, nodesep=0.3, bgcolor="transparent", pad="0.2", splines=polyline];
 node [shape=box, style="rounded,filled", fillcolor="#eef4fa", fontname="DejaVu Sans", fontsize=16];
 edge [fontname="DejaVu Sans", fontsize=11];
 "subject-bob" [id="subject-bob", label="Процесс Боба"];
 "subject-alice" [id="subject-alice", label="Процесс Алисы"];
 "object" [id="object", label="Файл Алисы"];
 "monitor" [id="monitor", label="Монитор доступа"];
 "owner" [id="owner", label="Владелец: Алиса"];
 "acl" [id="acl", label="ACL\nАлиса: чтение, запись\nБоб: чтение"];
 "subject-bob" -> "monitor" [id="request-flow-bob", label="операция"];
 "subject-alice" -> "monitor" [id="request-flow-alice", label="операция"];
 "owner" -> "acl" [label="задаёт права"];
 "acl" -> "monitor" [id="policy-flow", label="политика"];
 "monitor" -> "object" [id="access-flow", label="разрешённый доступ"];
}
