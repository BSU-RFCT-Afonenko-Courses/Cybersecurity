    [#question([(в) угроза;], scores.at(0).at(2))],
    [#question([(г) уязвимость;], scores.at(0).at(3))],
  )],
  [#list(spacing: item-spacing,
    [#question([(д) первое наблюдаемое событие;], scores.at(0).at(4))],
